    "Exports a presentation as a PDF of its slides, notes pages or handouts, as a PowerPoint file, or as PNG or JPEG images of one slide or every slide. The presentation isn't opened in a window." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Exportiert eine Präsentation als PDF ihrer Folien, Notizenseiten oder Handzettel, als PowerPoint-Datei oder als PNG- oder JPEG-Bilder einer Folie oder aller Folien. Die Präsentation wird nicht in einem Fenster geöffnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exports a presentation as a PDF of its slides, notes pages or handouts, as a PowerPoint file, or as PNG or JPEG images of one slide or every slide. The presentation isn't opened in a window."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Exporta una presentación como PDF de sus diapositivas, páginas de notas o documentos, como archivo de PowerPoint, o como imágenes PNG o JPEG de una diapositiva o de todas. La presentación no se abre en una ventana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Exporte une présentation au format PDF (diapositives, pages de notes ou documents), au format PowerPoint, ou en images PNG ou JPEG d'une diapositive ou de toutes les diapositives. La présentation n'est pas ouverte dans une fenêtre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esporta una presentazione come PDF delle diapositive, delle pagine note o degli stampati, come file PowerPoint oppure come immagini PNG o JPEG di una diapositiva o di tutte. La presentazione non viene aperta in una finestra."
          }
        }
      }
    },
