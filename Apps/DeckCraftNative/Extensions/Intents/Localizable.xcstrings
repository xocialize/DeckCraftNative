    "Gets how many slides a presentation has. The presentation isn't opened in a window." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ermittelt, wie viele Folien eine Präsentation hat. Die Präsentation wird nicht in einem Fenster geöffnet."
          }
        },
        "en" : {
