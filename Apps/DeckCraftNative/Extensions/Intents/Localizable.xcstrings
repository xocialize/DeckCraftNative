    "Gets the outline of a presentation: each slide's title and text, indented by tabs. The presentation isn't opened in a window." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ruft die Gliederung einer Präsentation ab: Titel und Text jeder Folie, mit Tabulatoren eingerückt. Die Präsentation wird nicht in einem Fenster geöffnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gets the outline of a presentation: each slide's title and text, indented by tabs. The presentation isn't opened in a window."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Obtiene el esquema de una presentación: el título y el texto de cada diapositiva, con sangría mediante tabulaciones. La presentación no se abre en una ventana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Obtient le plan d'une présentation : le titre et le texte de chaque diapositive, mis en retrait par des tabulations. La présentation n'est pas ouverte dans une fenêtre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ottiene la struttura di una presentazione: titolo e testo di ogni diapositiva, rientrati con tabulazioni. La presentazione non viene aperta in una finestra."
          }
        }
      }
    },
