<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- App extensions must be sandboxed. Shortcuts hands the extension the presentation file it is given (its URL with
     read access, or its bytes); the exported files are written in the extension's own temporary folder and handed
     back. Nothing else is read or written, and nothing goes to the network. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.security.files.user-selected.read-only</key>
  <true/>
</dict>
</plist>
