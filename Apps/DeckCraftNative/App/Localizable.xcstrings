    "Adds a slide after the current one in an open presentation, with a layout, a title and body text. Returns the new slide's number." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fügt in einer geöffneten Präsentation nach der aktuellen Folie eine Folie mit Layout, Titel und Text ein. Gibt die Nummer der neuen Folie zurück."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adds a slide after the current one in an open presentation, with a layout, a title and body text. Returns the new slide's number."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Agrega una diapositiva después de la actual en una presentación abierta, con un diseño, un título y texto principal. Devuelve el número de la nueva diapositiva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ajoute une diapositive après la diapositive actuelle dans une présentation ouverte, avec une disposition, un titre et un corps de texte. Renvoie le numéro de la nouvelle diapositive."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aggiunge una diapositiva dopo quella corrente in una presentazione aperta, con un layout, un titolo e un testo. Restituisce il numero della nuova diapositiva."
          }
        }
      }
    },
