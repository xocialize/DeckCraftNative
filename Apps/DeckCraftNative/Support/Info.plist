<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Merged with the generated Info.plist. The document types are deckcraft's
     (packaging/macos/Info.plist.in, MIT OR Apache-2.0): the .deckcraft format is byte-compatible, so both
     apps declare the same UTI. Templates and slide shows open as presentations; they save as .pptx or
     .deckcraft. Legacy PowerPoint 97–2003 files (.ppt, .pot, .pps; the system's own types) are this app's
     addition: they're read and converted, and open as untitled copies (Viewer). -->
<plist version="1.0">
<dict>
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>DeckCraft Presentation</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>NSDocumentClass</key>
      <string>DCApp.PresentationDocument</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>ai.storyteller.deckcraft.presentation</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>PowerPoint Presentation</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>NSDocumentClass</key>
      <string>DCApp.PresentationDocument</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>org.openxmlformats.presentationml.presentation</string>
      </array>
      <key>CFBundleTypeExtensions</key>
      <array><string>pptx</string></array>
      <key>CFBundleTypeMIMETypes</key>
      <array><string>application/vnd.openxmlformats-officedocument.presentationml.presentation</string></array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>PowerPoint Template</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>NSDocumentClass</key>
      <string>DCApp.PresentationDocument</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>org.openxmlformats.presentationml.template</string>
      </array>
      <key>CFBundleTypeExtensions</key>
      <array><string>potx</string></array>
      <key>CFBundleTypeMIMETypes</key>
      <array><string>application/vnd.openxmlformats-officedocument.presentationml.template</string></array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>PowerPoint Slide Show</string>
      <key>CFBundleTypeRole</key>
      <string>Editor</string>
      <key>NSDocumentClass</key>
      <string>DCApp.PresentationDocument</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>org.openxmlformats.presentationml.slideshow</string>
      </array>
      <key>CFBundleTypeExtensions</key>
      <array><string>ppsx</string></array>
      <key>CFBundleTypeMIMETypes</key>
      <array><string>application/vnd.openxmlformats-officedocument.presentationml.slideshow</string></array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>PowerPoint 97–2003 Presentation</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>NSDocumentClass</key>
      <string>DCApp.PresentationDocument</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>com.microsoft.powerpoint.ppt</string>
      </array>
      <key>CFBundleTypeExtensions</key>
      <array><string>ppt</string></array>
      <key>CFBundleTypeMIMETypes</key>
      <array><string>application/vnd.ms-powerpoint</string></array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>PowerPoint 97–2003 Template</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>NSDocumentClass</key>
      <string>DCApp.PresentationDocument</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>com.microsoft.powerpoint.pot</string>
      </array>
      <key>CFBundleTypeExtensions</key>
      <array><string>pot</string></array>
      <key>CFBundleTypeMIMETypes</key>
      <array><string>application/vnd.ms-powerpoint</string></array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>PowerPoint 97–2003 Slide Show</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>NSDocumentClass</key>
      <string>DCApp.PresentationDocument</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>com.microsoft.powerpoint.pps</string>
      </array>
      <key>CFBundleTypeExtensions</key>
      <array><string>pps</string></array>
      <key>CFBundleTypeMIMETypes</key>
      <array><string>application/vnd.ms-powerpoint</string></array>
    </dict>
  </array>

  <!-- DeckCraft's own format: a zip of a JSON manifest plus media. -->
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>ai.storyteller.deckcraft.presentation</string>
      <key>UTTypeDescription</key>
      <string>DeckCraft Presentation</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
        <string>public.presentation</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>deckcraft</string></array>
        <key>public.mime-type</key>
        <array><string>application/x-deckcraft</string></array>
      </dict>
    </dict>
  </array>
  <!-- Open XML presentations; the system's own declaration wins when it has one. -->
  <key>UTImportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>org.openxmlformats.presentationml.presentation</string>
      <key>UTTypeDescription</key>
      <string>Open XML Presentation</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
        <string>public.presentation</string>
        <string>public.zip-archive</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>pptx</string></array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>org.openxmlformats.presentationml.template</string>
      <key>UTTypeDescription</key>
      <string>Open XML Presentation Template</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
        <string>public.presentation</string>
        <string>public.zip-archive</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>potx</string></array>
      </dict>
    </dict>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>org.openxmlformats.presentationml.slideshow</string>
      <key>UTTypeDescription</key>
      <string>Open XML Slide Show</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
        <string>public.presentation</string>
        <string>public.zip-archive</string>
      </array>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array><string>ppsx</string></array>
      </dict>
    </dict>
  </array>

</dict>
</plist>
