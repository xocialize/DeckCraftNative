  "strings" : {
    "%@" : {
      "comment" : "An engine error message, shown as is.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@"
          }
        }
      }
    },
    "%@ couldn't be opened: %@" : {
      "comment" : "A presentation file an intent was given can't be read. The first value is the file name, the second the engine's reason.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ couldn't be opened: %2$@"
          }
        }
      }
    },
    "Exported %lld files." : {
      "comment" : "Export Presentation finished. The value is how many files it wrote.",
      "localizations" : {
        "en" : {
          "variations" : {
