    "%@ is open in Finder. Quit DeckCraftNative, then drag the new version onto Applications to replace this one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ ist im Finder geöffnet. Beenden Sie DeckCraftNative und ziehen Sie dann die neue Version auf „Programme“, um diese Version zu ersetzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is open in Finder. Quit DeckCraftNative, then drag the new version onto Applications to replace this one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ está abierto en Finder. Salga de DeckCraftNative y arrastre la nueva versión a Aplicaciones para reemplazar esta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ est ouvert dans le Finder. Quittez DeckCraftNative, puis faites glisser la nouvelle version dans Applications pour remplacer celle-ci."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ è aperto nel Finder. Esci da DeckCraftNative, poi trascina la nuova versione su Applicazioni per sostituire questa."
          }
        }
      }
    },
