    "Month names and AM/PM are listed for English. Other languages list the numeric date and 24-hour time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Monatsnamen und AM/PM werden für Englisch aufgeführt. Andere Sprachen zeigen das numerische Datum und die 24-Stunden-Zeit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Month names and AM/PM are listed for English. Other languages list the numeric date and 24-hour time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Los nombres de los meses y AM/PM se muestran en inglés. Los demás idiomas muestran la fecha en formato numérico y la hora en formato de 24 horas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Les noms des mois et AM/PM sont proposés pour l'anglais. Les autres langues proposent la date numérique et l'heure au format 24 heures."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "I nomi dei mesi e AM/PM sono disponibili in inglese. Le altre lingue mostrano la data in formato numerico e l'ora nel formato 24 ore."
          }
        }
      }
    },
