document.inspect
slide.inspect={"index":1}
view.slideMaster={"master":0}
master.preserve={"preserve":true}
design.browseTheme={"name":"smartart.pptx","data":""}
document.inspect
view.closeMaster
slide.inspect={"index":2}
design.browseTheme={"name":"brand.thmx","data":""}
design.variants
design.themes
