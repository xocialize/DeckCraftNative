# Design › Browse for Themes… with PowerPoint files (cmd/design.rs): the file's master and layouts replace the
# current one, slides move to the matching layouts, and a preserved master stays beside them; a .thmx
# brings its theme alone.
slide.new={"layout":"titleAndContent","title":"Agenda","body":"Point one"}
slide.new={"layout":"sectionHeader","title":"Part two"}
design.slideSize={"preset":"standard","scale":"none"}
