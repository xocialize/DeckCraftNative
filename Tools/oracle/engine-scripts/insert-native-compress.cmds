# Picture Format › Compress Pictures (cmd/compress.rs). ImageIO and vImage re-encode and resample where
# deckcraft uses the image crate: the pixel sizes, crops and formats are deckcraft's, the bytes (and so
# `after`) are not; InsertNativeScriptTests compares the pictures by pixel size.
slide.new={"layout":"blank"}
insert.picture={"data":"","name":"pattern.png","rect":[10,10,72,54]}
picture.compress={"ppi":96}
insert.picture={"data":"","name":"photo.jpg","rect":[100,10,48,36]}
picture.compress={"ppi":150,"deleteCropped":false}
insert.picture={"data":"","name":"see-through.png","rect":[200,10,40,30]}
picture.compress
picture.compress={"ppi":96}
insert.picture={"data":"","name":"big.png","rect":[300,10,700,500]}
picture.compress={"ppi":96}
slide.new={"layout":"pictureWithCaption"}
edit.select={"ids":[274]}
insert.picture={"data":"","name":"cropped.png"}
picture.compress={"ppi":96,"deleteCropped":false}
slide.inspect
slide.new={"layout":"pictureWithCaption"}
edit.select={"ids":[278]}
insert.picture={"data":"","name":"cropped-again.png"}
picture.compress={"ppi":96}
slide.inspect
slide.go={"index":0}
picture.compress={"ppi":36,"all":true}
document.inspect
!picture.compress={"ppi":5,"all":true}
!picture.compress={"ppi":2000,"all":true}
!picture.compress={"ids":[]}
