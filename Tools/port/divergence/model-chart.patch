+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub h_percent: Option<u32>,
+    /// `c:rotY`: the turn about the vertical axis in degrees (0…360).
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub rot_y: Option<u32>,
+    /// `c:depthPercent`: the depth as a percentage of the base (20…2000).
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub depth_percent: Option<u32>,
+    /// `c:rAngAx`: right-angled axes instead of a perspective view.
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub r_ang_ax: Option<bool>,
+    /// `c:perspective`: the field of view (0…240, half degrees).
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub perspective: Option<u32>,
+    /// The plot group's `c:gapDepth`: the gap between series in depth, in percent (0…500).
+    #[serde(skip_serializing_if = "Option::is_none")]
+    pub gap_depth: Option<u32>,
+    /// A 3-D bar's `c:shape`: `box`, `cylinder`, `cone`, `coneToMax`, `pyramid`, `pyramidToMax`.
+    #[serde(skip_serializing_if = "Option::is_none")]
